# Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SANITY_PROJECT_ID=jvgi63fz
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only. The dataset is private, so reads need a token; without one,
# unauthenticated reads silently return zero documents.
SANITY_API_TOKEN=
SANITY_API_READ_TOKEN=

# Optional — enables the /context evidence page.
SANITY_ORG_ID=ovihgdwkx
# Organisation-level token with Context Viewer. NOT the project token.
SANITY_CONTEXT_TOKEN=

# Optional — enables POST /api/ask.
ANTHROPIC_API_KEY=
